{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apoorv-profile",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-07-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "apoorvdarshan.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/resume", "/resume/", "/badges/downloads/*", "/badges/users/*", "/badges/scorecard/*"]
  }
}
